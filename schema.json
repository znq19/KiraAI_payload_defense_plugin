{
  "section_defense_general": {
    "type": "section",
    "name": "防御总控",
    "collapsed": false,
    "fields": {
      "defense_enabled": {
        "type": "switch",
        "name": "启用防御",
        "default": true
      },
      "defense_mode": {
        "type": "enum",
        "name": "防御模式",
        "default": "annotate",
        "options": ["annotate", "warn", "strict"],
        "hint": "annotate=标注外壳+剥离意图(推荐，省token且能看见内容) / warn=整段替换为拦截提示 / strict=直接丢弃"
      },
      "owner_qq": {
        "type": "list",
        "name": "主人QQ",
        "default": [],
        "hint": "仅用于日志/说明，一行一个"
      },
      "owner_whitelist": {
        "type": "list",
        "name": "白名单QQ",
        "default": [],
        "hint": "这些QQ跳过检测。测试注入时请勿把自己放进白名单"
      },
      "verbose_log": {
        "type": "switch",
        "name": "详细日志",
        "default": false
      }
    }
  },
  "injection_patterns": {
    "type": "json",
    "name": "注入特征",
    "default": {
      "patterns": [
        "\\[message_id:\\s*[\\d\\-]+\\]",
        "\\[group_name:",
        "\\[user_nickname:",
        "\\[sender_nickname:",
        "\\[user_id:\\s*\\d+\\]",
        "\\[sender_id:\\s*\\d+\\]",
        "\"sender_id\"\\s*:",
        "\"session_id\"\\s*:",
        "\"session_type\"\\s*:",
        "\"sender_nickname\"\\s*:",
        "\"message_id\"\\s*:"
      ],
      "min_hits": 3
    },
    "hint": "min_hits 建议 3，降低误杀。"
  }
}
